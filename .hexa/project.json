{
  "autonomous": {
    "enabled": true,
    "max_concurrent_agents": 3,
    "rollback_on_failure": true
  },
  "inference": {
    "tier_models": {
      "t1": "openai/gpt-oss-120b",
      "t2": "openai/gpt-oss-120b",
      "t2.5": "openai/gpt-oss-120b"
    },
    "timeout_secs": 600,
    "sop_via_router": true,
    "react_model": "devstral-small-2:24b",
    "react_models": [
      "devstral-small-2:24b",
      "claude-code"
    ],
    "lora": {
      "augment_model": "qwen2.5-coder:32b",
      "corpus_qa_count": 5,
      "enabled": true
    }
  },
  "auto_repair": {
    "enabled": false,
    "project_path": "examples/ebay-clone/backend",
    "max_iterations": 20,
    "top_k_files": 3
  },
  "analyze": {
    "exclude": [
      "hexa-cli/assets/scaffold",
