# Build output
target/
dist/
node_modules/
graph-out/
__pycache__/

# Local cargo config (sccache, lld, machine-specific)
.cargo/config.toml

# Environment. API keys are environment variables only, never files.
.env
.env.*

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude tooling: track skills and agents, ignore per-machine state
.claude/*
!.claude/skills/
!.claude/agents/
# The hook wiring is what puts the loop in front of the agent. It has to
# travel with the repository or a fresh checkout runs with no hooks at all.
!.claude/settings.json
.claude/settings.local.json
.mcp.json

# Logs and scratch
*.log
*.tmp
tmp/
test-output/

# Docs: track the ledger, the analyses, the guides and the top-level pages
docs/*
!docs/adrs/
# Decision trails are evidence (ADR-2609140928). A trail that is usually
# absent is a trail nobody trusts, so they are trackable by default.
!docs/trails/
!docs/analysis/
!docs/guides/
!docs/reference/
!docs/GETTING-STARTED.md
!docs/INFERENCE.md
!docs/COMPARISON.md
!docs/EVIDENCE.md

# .hexa is runtime state at any depth, except the files that define the
# project: its config, its rule set (what `hexa analyze .` checks this
# repository against) and its loop state (the ADR and gate in progress).
**/.hexa/*
!.hexa/project.json
!.hexa/ADR-rules.toml
!.hexa/loop.json

# Example projects are isolated repositories
examples/*/target/
examples/*/.git/
