# Filesystem artifacts
Volumes/
# .hexa is runtime state (at any depth) except the root config files below.
# ADR-rules.toml is the project's rule set, not per-machine state: it is what
# `hexa analyze .` checks this repository against, so it has to travel with the
# repository or every checkout enforces something different.
**/.hexa/*
!.hexa/project.json
!.hexa/project.yaml
!.hexa/ADR-rules.toml
.superset/
# weave framework runtime state (sibling repo ~/development/weave integration) — local db only
.weave/
examples/hexa-worktrees/
target/
examples/rust-api/target/
hexa-hub/target/

# Example projects are isolated git repos — ignore their build artifacts and git state
examples/*/target/
examples/*/.git/
examples/sandbox-demo/target/

# Built binaries (use target/ or ~/.hexa/bin/ instead)
bin/hexa-agent
bin/hexa-cli
bin/hexa-nexus
bin/hexa
bin/hexa-chat

# Scratch / generated artifacts
tmp/
test-output/
*.tmp

# SpacetimeDB module lock files
spacetime-modules/*/Cargo.lock

# SpacetimeDB claude config
spacetime-modules/.claude/
tla2tools.jar
hexflo_TTrace_*.tla

# hexa-graph knowledge-graph engine output
graph-out/

# Python build tooling caches
__pycache__/
